        "niveau": "easy",
        "reponse": "$f'(1) = -1$",
        "sousQuestions": [
          {
            "numero": "1.a",
            "texte": "Calculer $f(1+h)$ et $f(1)$.",
            "niveau": "easy",
            "reponse": "$f(1+h) = (1+h)^2 - 3(1+h) + 2 = 1 + 2h + h^2 - 3 - 3h + 2 = h^2 - h$<br>$f(1) = 1 - 3 + 2 = 0$"
          },
          {
