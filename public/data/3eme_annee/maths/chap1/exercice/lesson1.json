        "reponse": "$01000001_2 = 1 \\times 2^6 + 1 \\times 2^0 = 64 + 1 = 65_{10}$",
        "sousQuestions": [
          {
            "numero": "1.a",
            "texte": "Le code de 'B' est $01000010_2$. En déduire sa valeur décimale.",
            "niveau": "medium",
            "reponse": "$01000010_2 = 1 \\times 2^6 + 1 \\times 2^1 = 64 + 2 = 66_{10}$"
          },
          {
            "numero": "1.b",
            "texte": "Quel est le code binaire du caractère dont la valeur décimale est 90 ?",
            "niveau": "hard",
            "reponse": "$90_{10} = 64 + 16 + 8 + 2 = 2^6 + 2^4 + 2^3 + 2^1 = 01011010_2$"
          }
        ]
      }
    ]
